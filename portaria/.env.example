# =====================================================================
# Variáveis de ambiente — Plataforma Portaria
#
# Copia este ficheiro para `.env.local` e preenche com os valores do teu
# projeto Supabase (Dashboard > Project Settings > API).
#
# IMPORTANTE: `.env.local` NÃO deve ser commitado (está no .gitignore).
# =====================================================================

# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) — pode ser exposta ao cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — IGNORA RLS. Usar APENAS em código server-side seguro.
# NUNCA expor ao cliente nem prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
