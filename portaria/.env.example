# =====================================================================
# Variáveis de ambiente — Plataforma Portaria
#
# Copia este ficheiro para `.env.local` e preenche com os valores reais.
# NUNCA commitar `.env.local` (está no .gitignore) nem valores reais aqui.
#
# Legenda:
#   [obrigatória] — a app não funciona corretamente sem ela
#   [opcional]    — funcionalidade específica desligada silenciosamente se faltar
#   (build)       — lida em build time    (runtime) — lida em execução
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (núcleo — sem isto não há autenticação nem dados)
# ---------------------------------------------------------------------

# [obrigatória] (build+runtime) URL do projeto Supabase
# (ex: https://xxxxxxxx.supabase.co). Sem ela: a app não arranca.
NEXT_PUBLIC_SUPABASE_URL=

# [obrigatória] (build+runtime) Chave pública (anon) — exposta ao cliente
# por desenho. É o RLS que protege os dados, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [obrigatória] (runtime, server-only) Chave service_role — IGNORA RLS.
# Usada em caminhos server-side controlados (envio de email, escrita de
# mensagens do assistente, contagem de votos). NUNCA expor ao cliente nem
# prefixar com NEXT_PUBLIC_. Sem ela: emails, resposta do assistente e
# contagem de votos deixam de funcionar.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Email (Resend) — notificações por email
# ---------------------------------------------------------------------

# [opcional] (runtime) API key do Resend. Sem ela: nenhum email é enviado
# (as notificações in-app continuam a funcionar).
RESEND_API_KEY=

# [opcional] (runtime) Remetente dos emails (ex: "Portaria <no-reply@dominio.pt>").
# Sem ela: o envio de email falha/usa um default inválido.
EMAIL_FROM=

# ---------------------------------------------------------------------
# Assistente de IA (RAG) — ver decisão de âmbito do Beta (D-B)
# ---------------------------------------------------------------------

# [opcional] (runtime) API key da OpenAI. Gera TODOS os embeddings (indexação
# e pesquisa) e é o fallback do chat. Sem ela: a indexação e a pesquisa
# semântica do assistente não funcionam.
OPENAI_API_KEY=

# [opcional] (runtime) API key da DeepSeek — provedor primário do chat.
# ATENÇÃO: DeepSeek processa dados na China (ver auditoria 6.2 / L-44). Sem
# ela: o chat recai no fallback OpenAI (se OPENAI_API_KEY estiver definida).
DEEPSEEK_API_KEY=

# [opcional] (runtime) Modelo DeepSeek a usar (ex: "deepseek-chat").
# Sem ela: usa o default do código.
DEEPSEEK_MODEL=

# ---------------------------------------------------------------------
# Cron / agendamento (renovação de contratos) — ver A4
# ---------------------------------------------------------------------

# [opcional] (runtime) Segredo partilhado que protege o endpoint de cron.
# O agendador externo tem de enviar este valor. Sem ela: o endpoint de cron
# recusa os pedidos. Ver docs/operations/contract-renewal-cron.md.
CRON_SECRET=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------

# [opcional mas recomendada] (runtime) URL público base da app
# (ex: https://app.dominio.pt). Usada para construir links absolutos nos
# emails. Sem ela: os links de email podem ficar incorretos.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------
# Nota: alguns pontos do código toleram variantes alternativas
# (SUPABASE_ANON_KEY, SUPABASE_DATABASE_URL / NEXT_PUBLIC_SUPABASE_DATABASE_URL).
# Não são necessárias para o funcionamento normal; definir apenas se alguma
# ferramenta/script local as exigir.
# ---------------------------------------------------------------------
