# =====================================================================
# Variáveis de ambiente — Plataforma Portaria
#
# Copia este ficheiro para `.env.local` e preenche com os valores reais.
# NUNCA commitar `.env.local` (está no .gitignore) nem valores reais aqui.
#
# Legenda:
#   [obrigatória] — a app não funciona corretamente sem ela
#   [opcional]    — funcionalidade específica desligada silenciosamente se faltar
#   (build)       — lida em build time    (runtime) — lida em execução
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (núcleo — sem isto não há autenticação nem dados)
# ---------------------------------------------------------------------

# [obrigatória] (build+runtime) URL do projeto Supabase
# (ex: https://xxxxxxxx.supabase.co). Sem ela: a app não arranca.
NEXT_PUBLIC_SUPABASE_URL=

# [obrigatória] (build+runtime) Chave pública (anon) — exposta ao cliente
# por desenho. É o RLS que protege os dados, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [obrigatória] (runtime, server-only) Chave service_role — IGNORA RLS.
# Usada em caminhos server-side controlados (envio de email, escrita de
# mensagens do assistente, contagem de votos). NUNCA expor ao cliente nem
# prefixar com NEXT_PUBLIC_. Sem ela: emails, resposta do assistente e
# contagem de votos deixam de funcionar.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Email (Resend) — notificações por email
# ---------------------------------------------------------------------

# [opcional] (runtime) API key do Resend. Sem ela: nenhum email é enviado
# (as notificações in-app continuam a funcionar).
RESEND_API_KEY=

# [opcional] (runtime) Remetente dos emails (ex: "Portaria <no-reply@dominio.pt>").
# Sem ela: o envio de email falha/usa um default inválido.
EMAIL_FROM=

# ---------------------------------------------------------------------
# IA — processamento LOCAL (MLX, Apple Silicon) — decisão L-44
# (docs/legal/decisao-ia-l44.md, Opção D)
#
# Com MLX_EMBEDDINGS_URL e/ou MLX_CHAT_URL definidos, os provedores externos
# (OpenAI, DeepSeek) DEIXAM DE SER CHAMADOS — OpenAI_API_KEY e
# DEEPSEEK_API_KEY ficam OBSOLETOS: nenhum dado pessoal sai da
# infraestrutura própria. Sem as variáveis locais, mantém-se o
# comportamento legado (OpenAI/DeepSeek) para ambientes que ainda não
# migraram. Ver scripts/mlx-local/README.md.
# ---------------------------------------------------------------------

# [opcional] (runtime) URL do servidor local de embeddings (bge-m3, 1024
# dims; launchd do projeto DECIMA, porta 8099). Definir LIGA os embeddings
# locais.
MLX_EMBEDDINGS_URL=

# [opcional] (runtime) Bearer key do servidor de embeddings (EMBED_API_KEY
# do launchd DECIMA). Obrigatória se o servidor exigir autenticação.
MLX_EMBEDDINGS_KEY=

# [opcional] (runtime) Modelo de embeddings a declarar ao servidor.
# Default do código: "mlx-community/bge-m3-mlx-8bit".
MLX_EMBEDDINGS_MODEL=

# [opcional] (runtime) URL do servidor local de chat (Qwen3-8B-4bit, porta
# 8098 — ver scripts/mlx-local/). Definir LIGA o chat local (DeepSeek e
# OpenAI deixam de ser chamados).
MLX_CHAT_URL=

# [opcional] (runtime) Bearer key do servidor de chat, se exposto com
# autenticação. NUNCA expor o servidor sem key fora do localhost.
MLX_CHAT_KEY=

# [opcional] (runtime) Modelo de chat a declarar ao servidor.
# Default do código: "mlx-community/Qwen3-8B-4bit".
MLX_CHAT_MODEL=

# ---------------------------------------------------------------------
# IA legada (OpenAI/DeepSeek) — só usadas se as variáveis MLX_* acima não
# estiverem definidas
# ---------------------------------------------------------------------

# [opcional] (runtime, legado) API key da OpenAI. Sem MLX_* configurado:
# gera todos os embeddings e serve de fallback do chat.
OPENAI_API_KEY=

# [opcional] (runtime, legado) API key da DeepSeek — provedor primário do
# chat legado. ATENÇÃO: DeepSeek processa dados na China (auditoria 6.2 /
# L-44) — não usar em produção com dados reais.
DEEPSEEK_API_KEY=

# [opcional] (runtime, legado) Modelo DeepSeek a usar (ex: "deepseek-chat").
# Sem ela: usa o default do código.
DEEPSEEK_MODEL=

# ---------------------------------------------------------------------
# Cron / agendamento (renovação de contratos) — ver A4
# ---------------------------------------------------------------------

# [opcional] (runtime) Segredo partilhado que protege o endpoint de cron.
# O agendador externo tem de enviar este valor. Sem ela: o endpoint de cron
# recusa os pedidos. Ver docs/operations/contract-renewal-cron.md.
CRON_SECRET=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------

# [opcional mas recomendada] (runtime) URL público base da app
# (ex: https://app.dominio.pt). Usada para construir links absolutos nos
# emails. Sem ela: os links de email podem ficar incorretos.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------
# Nota: alguns pontos do código toleram variantes alternativas
# (SUPABASE_ANON_KEY, SUPABASE_DATABASE_URL / NEXT_PUBLIC_SUPABASE_DATABASE_URL).
# Não são necessárias para o funcionamento normal; definir apenas se alguma
# ferramenta/script local as exigir.
# ---------------------------------------------------------------------
